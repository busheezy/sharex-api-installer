{
  "name": "setup-sharex",
  "version": "0.0.1",
  "private": true,
  "description": "",
  "license": "UNLICENSED",
  "author": "",
  "scripts": {
    "build": "nest build",
    "format": "oxfmt --write .",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "lint": "oxlint --deny-warnings",
    "docker:build": "docker build --no-cache --pull --rm -t ghcr.io/busheezy/sharex-api-installer:latest .",
    "docker:push": "docker push ghcr.io/busheezy/sharex-api-installer:latest",
    "lint:fix": "oxlint --fix",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc --noEmit",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "bluebird": "^3.7.2",
    "dot": "2.0.0-beta.1",
    "fs-extra": "^11.0.0",
    "inquirer": "^8.2.4",
    "nanoid": "^3.0.0",
    "nanoid-dictionary": "^4.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.2.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@types/bluebird": "^3.5.36",
    "@types/express": "^5.0.0",
    "@types/fs-extra": "^11.0.0",
    "@types/inquirer": "^8.2.1",
    "@types/nanoid-dictionary": "^4.2.0",
    "@types/node": "^24.0.0",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "source-map-support": "^0.5.20",
    "ts-node": "^10.0.0",
    "tsconfig-paths": "4.0.0",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "packageManager": "pnpm@10.34.5"
}
