{
  "name": "setup-sharex",
  "version": "0.0.1",
  "private": true,
  "description": "",
  "license": "UNLICENSED",
  "author": "",
  "scripts": {
    "build": "nest build",
    "format": "oxfmt --write .",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "lint": "oxlint --deny-warnings",
    "docker:build": "docker build --no-cache --pull --rm -t ghcr.io/busheezy/sharex-api-installer:latest .",
    "docker:push": "docker push ghcr.io/busheezy/sharex-api-installer:latest",
    "lint:fix": "oxlint --fix",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc --noEmit",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "bluebird": "^3.7.2",
    "dot": "1.1.3",
    "fs-extra": "^11.4.0",
    "inquirer": "^14.2.1",
    "nanoid": "^6.0.1",
    "nanoid-dictionary": "^5.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@types/bluebird": "^3.5.42",
    "@types/dot": "^1.1.7",
    "@types/express": "^5.0.6",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^24.13.3",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "source-map-support": "^0.5.21",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "packageManager": "pnpm@12.3.4"
}
